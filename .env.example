# ==========================================
# Server Configuration
# ==========================================
PORT=8000
NODE_ENV=development
SERVER_DOMAIN=your_fallback_domain

# ==========================================
# Teler Configuration
# ==========================================
TELER_API_KEY=your_teler_api_key
TELER_SAMPLE_RATE=8k
TELER_CHUNK_SIZE=500

# ==========================================
# Sarvam Core Configuration
# ==========================================
SARVAM_SAMPLE_RATE=8000
SARVAM_MESSAGE_BUFFER_SIZE=5
SARVAM_AUDIO_CODEC=linear16
SARVAM_API_KEY=your_sarvam_api_key

# ==========================================
# Sarvam TTS Configuration
# ==========================================
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=shubh

# Static greeting played when the call starts
STATIC_RESPONSE_TEXT=Hello, Welcome to Teler Sarvam bridge integration. Hi, how are you. Hope you are doing good. How can I help you today?

# ==========================================
# Sarvam STT Configuration
# ==========================================
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_MODEL=saaras:v3-realtime

# ==========================================
# Sarvam LLM Configuration
# ==========================================
SARVAM_LLM_API=https://api.sarvam.ai/v1/chat/completions
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_MODEL_FALLBACK=sarvam-105b